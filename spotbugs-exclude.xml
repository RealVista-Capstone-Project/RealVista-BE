<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Exclude EI_EXPOSE_REP for DTOs - These are serialization objects -->
    <Match>
        <Class name="~.*\.dto\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for Spring-managed service constructors -->
    <Match>
        <Class name="~.*\.service\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for Domain services -->
    <Match>
        <Class name="~.*\.domain\..*Service"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for Spring-managed controllers -->
    <Match>
        <Class name="~.*\.controller\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for Spring-managed REST controllers -->
    <Match>
        <Class name="~.*\.rest\..*Controller"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for Spring Security Configuration -->
    <Match>
        <Class name="~.*\.config\.security\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for Spring-managed infrastructure services -->
    <Match>
        <Class name="~.*\.infrastructure\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude serialVersionUID warnings for value objects and DTOs -->
    <Match>
        <Or>
            <Class name="~.*\.value\..*"/>
            <Class name="~.*\.dto\..*"/>
            <Class name="~.*\..*Id"/>
        </Or>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>

    <!-- Exclude DM_CONVERT_CASE for value objects doing intentional normalization -->
    <Match>
        <Class name="~.*\.value\.Email"/>
        <Method name="of"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP for domain entities - Lombok @Getter returns mutable objects -->
    <Match>
        <Class name="~com\.sep\.realvista\.domain\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude DM_CONVERT_CASE for enum toValue/fromString methods -->
    <Match>
        <Class name="~.*\.MobilePlatform"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <!-- Exclude MS_MUTABLE_ARRAY for public static arrays in constants -->
    <Match>
        <Class name="~.*\.SecurityConstants.*"/>
        <Bug pattern="MS_MUTABLE_ARRAY"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP for GoogleTokenVerifier getters -->
    <Match>
        <Class name="~.*\.GoogleTokenVerifier"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- Exclude UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR for DocuSignConfig - @Value field initialized by Spring -->
    <Match>
        <Class name="com.sep.realvista.infrastructure.config.DocuSignConfig"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>

    <!-- Exclude REC_CATCH_EXCEPTION for DocuSignServiceImpl - broad catch needed for SDK compatibility -->
    <Match>
        <Class name="com.sep.realvista.infrastructure.external.docusign.DocuSignServiceImpl"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- Exclude DM_DEFAULT_ENCODING for LeaseAgreementController webhook - byte[] to String with explicit UTF-8 intent -->
    <Match>
        <Class name="com.sep.realvista.presentation.rest.listing.contract.LeaseAgreementController"/>
        <Bug pattern="DM_DEFAULT_ENCODING"/>
    </Match>

    <!-- Exclude DM_CONVERT_CASE for utility/service classes doing intentional case normalization -->
    <Match>
        <Class name="~.*\.SpacesStorageService"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>
    <Match>
        <Class name="~.*\.RecommendationController"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>
    <Match>
        <Class name="~.*\.SlugUtils"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <!-- Exclude SE_NO_SERIALVERSIONID for Spring Security UserDetails -->
    <Match>
        <Class name="com.sep.realvista.infrastructure.security.SecurityUserDetails"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP for SecurityUserDetails.getAuthorities() - Spring Security contract -->
    <Match>
        <Class name="com.sep.realvista.infrastructure.security.SecurityUserDetails"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for WebSocketController - Spring-managed bean -->
    <Match>
        <Class name="com.sep.realvista.presentation.websocket.WebSocketController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE for AiServiceClient - null handled at runtime -->
    <Match>
        <Class name="com.sep.realvista.infrastructure.external.ai.AiServiceClient"/>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <!-- Exclude DM_CONVERT_CASE for listing services doing case-insensitive DB queries -->
    <Match>
        <Class name="~.*\.application\.listing\.service\..*"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <!-- Exclude EI_EXPOSE_REP2 for application layer mappers and services (Spring-managed, constructor injection) -->
    <Match>
        <Class name="~.*\.application\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude DM_CONVERT_CASE for engagement and lease services -->
    <Match>
        <Class name="~.*\.application\.engagement\..*"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>
    <Match>
        <Class name="~.*\.application\.listing\.contract\..*"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <!-- Exclude REC_CATCH_EXCEPTION for application services using broad catch for SDK/IO compatibility -->
    <Match>
        <Class name="~.*\.application\.listing\.contract\.LeaseAgreementApplicationService"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- Exclude UPM_UNCALLED_PRIVATE_METHOD for MapStruct helper methods called via reflection -->
    <Match>
        <Class name="~.*\.application\.listing\.mapper\.ListingMapper"/>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>

    <!-- Exclude DB_DUPLICATE_SWITCH_CLAUSES for intentional fall-through in sort handling -->
    <Match>
        <Class name="~.*\.application\.listing\.service\.ListingSearchService"/>
        <Bug pattern="DB_DUPLICATE_SWITCH_CLAUSES"/>
    </Match>

</FindBugsFilter>

